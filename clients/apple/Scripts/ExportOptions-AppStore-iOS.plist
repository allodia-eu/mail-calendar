<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for `xcodebuild -exportArchive` in the iOS/iPadOS App Store flow (Scripts/package.sh
  --ios-app-store). Every __PLACEHOLDER__ is substituted into a copy under build/ at run time, so
  no team id, profile or certificate name is committed.

  MANUAL signing, against a profile that is already installed. Automatic signing asks App Store
  Connect to manage the distribution assets, and a key without permission for that is refused with
  "Cloud signing permission error" while an installed profile sits unused beside it, since automatic
  signing does not read one. Manual signing is also what the macOS Store flow does, so both Store
  flows now sign against an explicit profile rather than one of them depending on an account.

  signingCertificate names the certificate by COMMON NAME, which `codesign` cannot use when two
  certificates share it. That ambiguity is resolved before we get here: package.sh picks the profile
  whose authorised certificate is in the keychain, so the profile named below lists exactly one of
  them and the export has no choice left to make.

  method=app-store-connect is the current name (Xcode 15.3+; the repo pins Xcode 26+). destination=
  export writes a local .ipa instead of uploading, so upload stays an explicit step (Transporter /
  altool). manageAppVersionAndBuildNumber=false is LOAD-BEARING: the app's CFBundleVersion is the
  dotted UTC timestamp package.sh stamps (docs/versioning.md); leaving Xcode to "manage" it would
  clobber that stamp with its own value.
-->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>teamID</key>
    <string>__TEAM_ID__</string>
    <key>signingStyle</key>
    <string>manual</string>
    <key>signingCertificate</key>
    <string>__SIGNING_CERTIFICATE__</string>
    <key>provisioningProfiles</key>
    <dict>
        <key>__BUNDLE_ID__</key>
        <string>__PROFILE_UUID__</string>
    </dict>
    <key>destination</key>
    <string>export</string>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
    <key>uploadSymbols</key>
    <true/>
</dict>
</plist>
