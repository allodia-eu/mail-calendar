# Generated by XcodeGen from project.yml (project.yml is the source of truth).
*.xcodeproj

# Rich-composer editor bundle, copied from clients/composer by build-core.sh.
Packages/MailcalKit/Sources/MailcalUI/composer/

# Built by Scripts/build-core.sh from the Rust source of truth. UniFFI emits the Swift
# binding *and* its C FFI header + modulemap together, all three are regenerated per build.
Packages/MailcalKit/artifacts/
Packages/MailcalKit/Sources/MailcalBindings/*.swift
Packages/MailcalKit/Sources/MailcalBindings/*.h
Packages/MailcalKit/Sources/MailcalBindings/*.modulemap

# Xcode / SwiftPM build products. `build/` also covers the packaging outputs (Scripts/package.sh
# writes the archive, export, generated ExportOptions, and the .dmg/.pkg under build/).
build/
.build/
DerivedData/
App/Info.plist

# Local signing config for Scripts/package.sh (Team ID + cert/notary names). The committed
# signing.local.sh.example is the template; the filled-in copy stays per-machine and out of git.
signing.local.sh

# The same Team ID in the form the BUILD reads for a physical-device build, written by
# Scripts/build-and-run.sh --device and optionally included by the committed signing.xcconfig.
signing.local.xcconfig
