<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Grants the app a keychain access group so SecItemAdd/Copy succeed (without this an
         unsigned/entitlement-less app can't persist Keychain items on iOS, writes fail with
         errSecMissingEntitlement and the account is gone on the next launch). -->
    <key>keychain-access-groups</key>
    <array>
        <!-- Must carry the team prefix (via $(AppIdentifierPrefix)) to be a valid access group;
             a bare bundle id doesn't match the app's application-identifier, so the default group
             is invalid and SecItemAdd still fails. The id half is $(PRODUCT_BUNDLE_IDENTIFIER)
             rather than a literal so a re-branded build (docs/branding.md) cannot claim the
             group of the build it is not. -->
        <string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    </array>

    <!-- The container a share is handed over in (docs/os-integration.md). The Share Extension
         stages the shared bytes here and leaves a note; this app reads it on every activation.
         Byte-identical to the extension's own entitlement, which builds the same string from
         $(MAILCAL_HOST_APP_ID) because its PRODUCT_BUNDLE_IDENTIFIER is the extension's, not the
         app's. No team-id prefix, matching the group the Mac App Store build already carries. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    </array>
</dict>
</plist>
