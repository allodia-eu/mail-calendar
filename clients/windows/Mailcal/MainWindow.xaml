<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Allodia.Mailcal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Allodia.Mailcal.Views"
    xmlns:controls="using:Allodia.Mailcal.Controls"
    xmlns:l10n="using:Allodia.Mailcal">

    <!-- Mica is what makes the extended title bar read as part of the window rather than a strip
         painted on top of it: the caption area and the NavigationView pane share the desktop-tinted
         backdrop, and the detail panes sit on their own layer above it. Base (not BaseAlt) because
         this is a top-level app window, per the Fluent material guidance. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The window's caption, drawn by the app rather than by the system, on the terms
             Services/WindowCaption.cs states; the height and the brand icon are the application's
             (App.xaml), so this window and the reading and composer windows beside it cannot come
             up looking like three applications.

             The pane toggle moves up here from the NavigationView, which is the Fluent guidance
             when a custom title bar exists, it sits with the caption instead of hanging over the
             sidebar. It is hidden on the welcome and setup screens, where there is no pane behind
             it to collapse.

             The search field is a SIBLING of the TitleBar rather than its Content, and this Grid
             is what the window is given as its caption (MainWindow.TitleBar.cs). Content is the
             obvious slot and it centres what is in it on the room the caption buttons leave, which
             is not the middle of the window; over this Grid the field is simply centred on the
             glass. The drag region is computed from this element minus the interactive things
             inside it, so both the field and the pane toggle still take a click. -->
        <Grid x:Name="CaptionRow" Grid.Row="0" MinHeight="{StaticResource AppCaptionHeight}">
            <TitleBar
                x:Name="AppTitleBar"
                AutomationProperties.AutomationId="AppTitleBar"
                Title="{x:Bind l10n:L10n.AppTitle(), Mode=OneTime}"
                IsPaneToggleButtonVisible="{x:Bind IsVisible(Model.MainVisibility), Mode=OneWay}"
                IconSource="{StaticResource AppCaptionIcon}"
                SizeChanged="OnTitleBarSizeChanged"
                PaneToggleRequested="OnTitleBarPaneToggle" />
            <!-- The search field, over the middle of the window. Its default scope is every
                 account and every folder (docs/search.md, rule 2), so drawn over the message list
                 it was a control whose reach was wider than the one column it sat on; the window's
                 top row is the only surface here whose centre is not a pane's.

                 Mail only: a field over the calendar or contacts would narrow nothing on screen,
                 and each of those surfaces carries its own. Its width is set in
                 MainWindow.Search.cs, from the room the caption's own furniture leaves it. -->
            <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind MailChromeShown(Model.MainVisibility, Model.MailVisibility), Mode=OneWay}"
                            PlaceholderText="{x:Bind l10n:L10n.SearchPlaceholder(), Mode=OneTime}"
                            TextChanged="OnSearchChanged" />
        </Grid>

        <!-- The mail command bar (docs/command-bar.md), across the whole window under the
             caption, and with it one band of window chrome on the window's Mica, as the folder
             pane is: no separator between the two rows and no fill of its own, so the band and the
             pane frame the list and the reading pane, which keep the content layer.

             New Mail heads it in a slot as wide as the folder pane, open or compact
             (MainWindow.CommandBar.cs), so the actions start at the message list's leading edge and
             follow the pane's divider; a compact pane narrows the slot to New Mail's own width and
             the actions follow it. New Mail names no selection, so it is never disabled, and a pane
             that can be shut cannot hold the one control that writes a message.

             The row is the mail surface's; the calendar and contacts draw their own. The actions
             are the core's answer, drawn in code as it arrives: a WinUI CommandBar,
             whose dynamic overflow moves items from the end into its "More" menu in bar order when
             the row cannot hold them, so a label never wraps, truncates or scrolls. -->
        <Grid x:Name="CommandRow" Grid.Row="1"
              Padding="0,0,8,6"
              Visibility="{x:Bind MailChromeShown(Model.MainVisibility, Model.MailVisibility), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NewMailColumn" Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ComposeButton"
                    Margin="12,0,12,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="ComposeButton"
                    AutomationProperties.Name="{x:Bind l10n:L10n.ActionCompose(), Mode=OneTime}"
                    Click="OnNewMail">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    <TextBlock Text="{x:Bind l10n:L10n.ActionCompose(), Mode=OneTime}" TextWrapping="NoWrap" />
                </StackPanel>
            </Button>
            <!-- Left-aligned, so the actions start at the list's edge rather than the bar's end; the
                 column still bounds it, which is the width its dynamic overflow measures against. -->
            <CommandBar x:Name="MailCommands" Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        IsOpen="False"
                        IsDynamicOverflowEnabled="True"
                        DefaultLabelPosition="Right"
                        OverflowButtonVisibility="Auto"
                        AutomationProperties.AutomationId="MailCommandBar"
                        Loaded="OnMailCommandsLoaded" />
        </Grid>        <!-- The launch view and the three top-level surfaces are mutually exclusive and all share
             row 2, under the caption and the actions bar, they overlap deliberately (only one is
             ever Visible), so they are siblings rather than a nested Grid. -->

        <!-- While the core is opening (docs/boot-sequence.md, "Hosting the constructor: the launch
             view"). The other surfaces are collapsed meanwhile, so the window is a blank page, and
             this shows only once the open has outlasted the core's launch-status delay. The
             automation id is on the ring: a StackPanel has no automation peer, so an id on it is
             in no UI Automation tree. -->
        <StackPanel
            x:Name="LaunchHost"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind Model.LaunchVisibility, Mode=OneWay}">
            <ProgressRing Width="36" Height="36" HorizontalAlignment="Center"
                          AutomationProperties.AutomationId="LaunchView"
                          IsActive="{x:Bind IsVisible(Model.LaunchVisibility), Mode=OneWay}" />
            <TextBlock Text="{x:Bind l10n:L10n.StatusOpeningMailbox(), Mode=OneTime}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- First boot: welcome + the usage-statistics question, ahead of setup and everything
             else. It outranks the setup form (see MailboxModel's three visibility properties), and
             the demo/showcase report the question settled, so no screenshot run ever sees it. -->
        <views:WelcomeView
            x:Name="Welcome"
            Grid.Row="2"
            Visibility="{x:Bind Model.WelcomeVisibility, Mode=OneWay}" />

        <!-- First run: the account-setup form (no account stored yet). Adding a later account
             lifts the same form out of this host and into a dialog over the shell, and puts it
             back when the dialog closes (MainWindow.AddAccount.cs). -->
        <Border
            x:Name="SetupHost"
            Grid.Row="2"
            Visibility="{x:Bind Model.SetupVisibility, Mode=OneWay}">
            <views:AccountSetupView x:Name="SetupView" />
        </Border>

        <!-- Connected: the sidebar + detail shell.

             No NavigationView Header: every detail surface already titles itself, the message
             list's own header row carries the folder name and the calendar carries "Calendar"
             beside New event, so a shell header only restated it a second time
             and spent ~60px of height doing so, on both the list and the reading pane. The title
             stays where it is read (next to the content it names) and the panes get the space.
             AlwaysShowHeader="False" collapses the header area itself, not just its content. -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="2"
            Visibility="{x:Bind Model.MainVisibility, Mode=OneWay}"
            AlwaysShowHeader="False"
            IsSettingsVisible="True"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            MenuItemsSource="{x:Bind SidebarItems, Mode=OneTime}"
            FooterMenuItemsSource="{x:Bind FooterItems, Mode=OneTime}"
            ContextRequested="OnNavContextRequested"
            ItemInvoked="OnNavItemInvoked">

            <!-- Declared per view rather than once in App.xaml: App.xaml is compiled in the
                 markup compiler's FIRST pass, before this project's own types exist, so a converter
                 there fails the build with "Unknown type" on every local type in the project, an
                 error that names them all and not the line that caused it. -->
            <NavigationView.Resources>
                <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
                <views:MarkToneBrushConverter x:Key="MarkToneBrush" />
            </NavigationView.Resources>

            <!-- The accordion is BOUND, not hand-built. It used to be reconstructed from scratch,
                 MenuItems.Clear() and a fresh NavigationViewItem per account and folder, on every
                 CollectionChanged event the model raised, and the model refills its Folders with
                 Clear() + one Add() per folder. So opening a 57-folder account meant sixty full
                 rebuilds and ten seconds of frozen UI thread, against 2 ms for the core's half of
                 the same refresh. Bound to a collection the shell reconciles in place
                 (ViewModels/SidebarTree.cs), the framework hears only what actually changed.

                 Three templates, because only an account row may carry the "Remove account"
                 menu: offering it on a folder would name the wrong thing and destroy an account.
                 The selector keys off SidebarItem.AccountId, and off IsGroup for the All Accounts
                 heading. Every level of the tree draws through it, an account's folders and a
                 folder's own folders alike, each a child of its parent's item via
                 MenuItemsSource.

                 {Binding}, NOT {x:Bind Mode=OneTime}, these are the only two in the app, so the reason has to
                 live here. x:Bind compiles a cast of the template's data root to its x:DataType, and
                 NavigationView hands an item template a raw WinRT.IInspectable rather than the
                 projected object: every row threw InvalidCastException before the sidebar drew a
                 single entry. The identical pattern over a ListView is fine (MailListView.xaml,
                 x:DataType="vm:MailRow"), so this is NavigationView's item plumbing and not the
                 types, do not "fix" it back to x:Bind on the strength of the rest of the file.
                 {Binding} resolves against the DataContext by reflection and does not care. -->
            <NavigationView.MenuItemTemplateSelector>
                <views:SidebarItemTemplateSelector>
                    <views:SidebarItemTemplateSelector.Plain>
                        <DataTemplate>
                            <!-- AutomationProperties.Name is REQUIRED here, not decoration. A
                                 NavigationViewItem derives its spoken name from Content, and this
                                 template's Content is a Grid rather than the label string, so
                                 without this the row has no name at all: invisible to a screen
                                 reader, and unfindable by every automation lookup, while looking
                                 exactly right on screen. The UI suite caught precisely that. -->
                            <!-- A folder can hold folders, so the plain template nests too. An
                                 item whose Children are empty draws no chevron, which is exactly
                                 the rule: a disclosure control beside a folder holding nothing but
                                 mail promises a tree that is not there. IsExpanded is TwoWay for
                                 the reason the account template's is, the chevron the user clicks
                                 writes back and reaches the core, which persists it. -->
                            <!-- A folder change the server has not confirmed draws dimmed, says so
                                 on hover and to a screen reader, and offers nothing until it clears
                                 (docs/folder-pane.md, rule 27). A folder the core lets move can be
                                 dragged onto a folder or its account's row, and mail onto a folder.
                                 DragOver and Drop are the row's own, never the NavigationView's: a
                                 drag over a row does not reach the NavigationView's handlers
                                 (MainWindow.Folders.cs decides what lands). -->
                            <NavigationViewItem
                                Tag="{Binding Tag}"
                                SelectsOnInvoked="{Binding SelectsOnInvoked}"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                MenuItemsSource="{Binding Children}"
                                Opacity="{Binding RowOpacity}"
                                ToolTipService.ToolTip="{Binding PendingTip}"
                                CanDrag="{Binding Editable}"
                                AllowDrop="True"
                                DragOver="OnSidebarDragOver"
                                Drop="OnSidebarDrop"
                                DragStarting="OnSidebarDragStarting"
                                DropCompleted="OnSidebarDropCompleted"
                                Loaded="OnSidebarRowLoaded"
                                AutomationProperties.Name="{Binding Content}"
                                AutomationProperties.HelpText="{Binding PendingLabel}"
                                AutomationProperties.AutomationId="{Binding AutomationId}">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="{Binding Glyph}" />
                                </NavigationViewItem.Icon>
                                <!-- The label and its unread count, rather than a bare Content
                                     string: a folder badge sits at the trailing edge, which needs a
                                     two-column row.

                                     Not a NavigationViewItem.InfoBadge, that slot is a filled
                                     accent pill, which is right for the account row's outage dot and
                                     far too loud repeated down twenty folders. Outlook draws a plain
                                     accent number, and so do we.

                                     Hidden at zero, which deliberately also hides "this provider
                                     reports no count" (Gmail today): both mean we have nothing
                                     truthful to show, and a 0 badge would claim we had looked.
                                     AutomationProperties.Name carries the localized sentence,
                                     because "Inbox, 545" read aloud is a position in a list. -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding Content}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding UnreadText}"
                                        Visibility="{Binding ShowUnread, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="{Binding UnreadLabel}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </NavigationViewItem>
                        </DataTemplate>
                    </views:SidebarItemTemplateSelector.Plain>
                    <views:SidebarItemTemplateSelector.Account>
                        <DataTemplate>
                            <!-- IsExpanded is TwoWay so collapsing an account by hand sticks rather
                                 than being overwritten by the next background sync. -->
                            <!-- The address in full on hover. The pane is draggable now, but an
                                 address can always outrun whatever width the user picked, and a
                                 row reading "eva.jansen@example.c…" is exactly when they need to
                                 know which account it is. -->
                            <!-- A folder dropped on its account's row moves to the top of the tree
                                 (docs/folder-pane.md, rule 24); the row handles the drop itself, as
                                 a folder row does. -->
                            <!-- A notice about the account marks the row with one line beneath
                                 the address, a glyph and the notice's short mark, readable rather
                                 than a tooltip (docs/notices.md rule 6). One line, never wrapped:
                                 the sentences are the bar's. A screen reader hears every one of
                                 the account's notices as the row's status; the name stays the
                                 address, which is what the row is. -->
                            <NavigationViewItem
                                Tag="{Binding Tag}"
                                ToolTipService.ToolTip="{Binding Content}"
                                AutomationProperties.Name="{Binding Content}"
                                AutomationProperties.ItemStatus="{Binding MarkDetail}"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                AllowDrop="True"
                                DragOver="OnSidebarDragOver"
                                Drop="OnSidebarDrop"
                                Loaded="OnSidebarRowLoaded"
                                MenuItemsSource="{Binding Children}">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="{Binding Glyph}" />
                                </NavigationViewItem.Icon>
                                <StackPanel Padding="0,4">
                                    <TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="6"
                                          Visibility="{Binding HasMark, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0"
                                                  Glyph="{Binding MarkGlyph}"
                                                  FontSize="12"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw"
                                                  Foreground="{Binding MarkTone, Converter={StaticResource MarkToneBrush}}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding MarkLabel}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   AutomationProperties.AutomationId="AccountNoticeLabel" />
                                    </Grid>
                                </StackPanel>
                                <!-- No ContextFlyout here: a NavigationViewItem declared in an item
                                     template never receives the right-click, so one set here opens
                                     for nobody. The row's menu (New folder, Remove account) is
                                     raised from the NavigationView's own ContextRequested instead,
                                     MainWindow.Sidebar.cs. -->
                            </NavigationViewItem>
                        </DataTemplate>
                    </views:SidebarItemTemplateSelector.Account>
                    <views:SidebarItemTemplateSelector.Group>
                        <DataTemplate>
                            <!-- The All Accounts heading. SelectsOnInvoked="False" is the whole of
                                 rule 17 (docs/folder-pane.md): the row navigates nowhere, so
                                 invoking it anywhere along its length opens or shuts its tree,
                                 which is what a heading should do and what an account row, being a
                                 destination, needs a separate chevron for.

                                 No Icon, deliberately: the chevron leading the row is the state, and
                                 a glyph beside the account rows' would make this read as one more
                                 account. IsExpanded is TwoWay for the same reason the account
                                 template's is. SemiBold, as the account rows are: the weight is
                                 what titles a group whose folders stand in its own columns
                                 (docs/folder-pane.md, rule 32). -->
                            <NavigationViewItem
                                Content="{Binding Content}"
                                Tag="{Binding Tag}"
                                SelectsOnInvoked="False"
                                FontWeight="SemiBold"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                Loaded="OnSidebarRowLoaded"
                                MenuItemsSource="{Binding Children}" />
                        </DataTemplate>
                    </views:SidebarItemTemplateSelector.Group>
                </views:SidebarItemTemplateSelector>
            </NavigationView.MenuItemTemplateSelector>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The shell's banner strip: the notice bar, which collapses itself when it has
                     nothing to say (NoticeBar.xaml). -->
                <StackPanel Grid.Row="0" x:Name="ContentBanners">
                    <!-- The core's notices (docs/notices.md): one bar, the first notice that belongs to
                         the screen on show, and the rest behind its "more" button, never stacked. -->
                    <views:NoticeBar x:Name="NoticeStrip" />
                </StackPanel>

                <!-- The detail area: the calendar agenda, or the three-pane mail view, the
                     message list and the reading pane side by side (the NavigationView pane is
                     the sidebar), with the open message reflected inline beside the list. -->
                <Grid Grid.Row="1">
                    <!-- Mail: list | draggable divider | reading pane. Hidden as a whole for the
                         calendar. The divider is a ColumnSplitter: dragging it resizes the list
                         column (pinned to pixels on first drag) while the reading column, the lone
                         star, absorbs the remainder, clamped so neither pane drops below MinWidth.
                         See OnSplitter* in the code-behind. -->
                    <Grid x:Name="MailGrid" SizeChanged="OnMailGridSizeChanged"
                          Visibility="{x:Bind Model.MailVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ListColumn" Width="2*" MinWidth="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="ReadingColumn" Width="3*" MinWidth="380" />
                        </Grid.ColumnDefinitions>

                        <views:MailListView x:Name="MailView" Grid.Column="0" />
                        <controls:ColumnSplitter x:Name="PaneSplitter" Grid.Column="1" Width="8"
                                Background="Transparent"
                                PointerPressed="OnSplitterPressed" PointerMoved="OnSplitterMoved"
                                PointerReleased="OnSplitterReleased" PointerCaptureLost="OnSplitterCaptureLost">
                            <Border Width="1" HorizontalAlignment="Center"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </controls:ColumnSplitter>
                        <views:ReadingView x:Name="ReadingPanel" Grid.Column="2" />
                        <!-- The composer takes the reading pane's slot while a draft is open,
                             behind the same splitter, so the sidebar and the message list stay
                             live and clickable (they were blacked out by the old modal). Exactly
                             one of the two is visible; MainWindow.Compose.cs owns the swap. -->
                        <ContentControl x:Name="ComposerHost" Grid.Column="2"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                    </Grid>
                    <views:CalendarView
                        x:Name="CalendarDetail"
                        Visibility="{x:Bind Model.CalendarVisibility, Mode=OneWay}" />
                    <!-- Contacts follows the MAIL layout, not the calendar's: a list of people is
                         something you pick one of, where the calendar is one wide grid with nothing
                         to select beside it. -->
                    <views:ContactsView
                        x:Name="ContactsDetail"
                        Visibility="{x:Bind Model.ContactsVisibility, Mode=OneWay}" />
                </Grid>

                <!-- Drag the pane|content boundary to widen the folder tree, so a long account
                     address is readable rather than clipped mid-domain. The twin of the
                     list|reading splitter below it, down to the persisted width.

                     It lives HERE, as the last child of the NavigationView's content and pinned to
                     its left edge, because that edge IS the pane boundary, the content area starts
                     at OpenPaneLength. Declared last so it wins the hit test over the views beneath
                     it; last in the content rather than in the pane because a NavigationView clips
                     its pane, so a grip on that side would be half unhittable.

                     Deliberately invisible: NavigationView already draws the divider, and a second
                     hairline on top of it reads as a rendering bug. The resize cursor is the
                     affordance, which is what File Explorer's own navigation pane does. -->
                <controls:ColumnSplitter
                    x:Name="SidebarSplitter"
                    Grid.Row="0" Grid.RowSpan="2"
                    Width="8"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    AutomationProperties.AutomationId="SidebarSplitter"
                    AutomationProperties.Name="{x:Bind l10n:L10n.A11yResizeFolderPane(), Mode=OneTime}"
                    PointerPressed="OnSidebarSplitterPressed"
                    PointerMoved="OnSidebarSplitterMoved"
                    PointerReleased="OnSidebarSplitterReleased"
                    PointerCaptureLost="OnSidebarSplitterCaptureLost" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
