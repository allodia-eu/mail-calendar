<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Allodia.Mailcal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Allodia.Mailcal.Views"
    xmlns:controls="using:Allodia.Mailcal.Controls"
    xmlns:l10n="using:Allodia.Mailcal">

    <!-- Mica is what makes the extended title bar read as part of the window rather than a strip
         painted on top of it: the caption area and the NavigationView pane share the desktop-tinted
         backdrop, and the detail panes sit on their own layer above it. Base (not BaseAlt) because
         this is a top-level app window, per the Fluent material guidance. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The window's caption, drawn by us rather than by the system. The system one is a
             separate surface from the app's content: it does not read the app's theme, so it came
             up pale over a dark window, and the only lever it offers is a set of AppWindowTitleBar
             colour properties that each have to be re-set by hand on every theme change. The
             TitleBar control is content, so it inherits ActualTheme like everything else and follows
             a light/dark switch for free, and it owns the drag regions, the caption button spacing
             (incl. RTL) and the min-drag region, none of which is then hand-computed.
             MainWindow.TitleBar.cs hands the window over to it, and mirrors the theme onto the one
             piece the framework still will not: the system-drawn caption buttons.

             The pane toggle moves up here from the NavigationView, which is the Fluent guidance
             when a custom title bar exists, it sits with the caption instead of hanging over the
             sidebar. It is hidden on the welcome and setup screens, where there is no pane behind
             it to collapse. -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            AutomationProperties.AutomationId="AppTitleBar"
            Title="{x:Bind l10n:L10n.AppTitle()}"
            IsPaneToggleButtonVisible="{x:Bind IsVisible(Model.MainVisibility), Mode=OneWay}"
            PaneToggleRequested="OnTitleBarPaneToggle">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Images/app.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- The three top-level surfaces are mutually exclusive and all share row 1, under the
             caption, they overlap deliberately (only one is ever Visible), so they are siblings
             rather than a nested Grid. -->

        <!-- First boot: welcome + the usage-statistics question, ahead of setup and everything
             else. It outranks the setup form (see MailboxModel's three visibility properties), and
             the demo/showcase report the question settled, so no screenshot run ever sees it. -->
        <views:WelcomeView
            x:Name="Welcome"
            Grid.Row="1"
            Visibility="{x:Bind Model.WelcomeVisibility, Mode=OneWay}" />

        <!-- First run: the account-setup form (no account stored yet). -->
        <views:AccountSetupView
            x:Name="SetupView"
            Grid.Row="1"
            Visibility="{x:Bind Model.SetupVisibility, Mode=OneWay}" />

        <!-- Connected: the sidebar + detail shell.

             No NavigationView Header: every detail surface already titles itself, the message
             list's own header row carries the folder name beside the search box, and the calendar
             carries "Calendar" beside New event, so a shell header only restated it a second time
             and spent ~60px of height doing so, on both the list and the reading pane. The title
             stays where it is read (next to the content it names) and the panes get the space.
             AlwaysShowHeader="False" collapses the header area itself, not just its content. -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            Visibility="{x:Bind Model.MainVisibility, Mode=OneWay}"
            AlwaysShowHeader="False"
            IsSettingsVisible="True"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            MenuItemsSource="{x:Bind SidebarItems}"
            FooterMenuItemsSource="{x:Bind FooterItems}"
            ContextRequested="OnNavContextRequested"
            ItemInvoked="OnNavItemInvoked">

            <!-- Declared per view rather than once in App.xaml: App.xaml is compiled in the
                 markup compiler's FIRST pass, before this project's own types exist, so a converter
                 there fails the build with "Unknown type" on every local type in the project, an
                 error that names them all and not the line that caused it. -->
            <NavigationView.Resources>
                <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            </NavigationView.Resources>

            <!-- The accordion is BOUND, not hand-built. It used to be reconstructed from scratch,
                 MenuItems.Clear() and a fresh NavigationViewItem per account and folder, on every
                 CollectionChanged event the model raised, and the model refills its Folders with
                 Clear() + one Add() per folder. So opening a 57-folder account meant sixty full
                 rebuilds and ten seconds of frozen UI thread, against 2 ms for the core's half of
                 the same refresh. Bound to a collection the shell reconciles in place
                 (ViewModels/SidebarTree.cs), the framework hears only what actually changed.

                 Two templates, because only an account row may carry the "Remove account" menu:
                 offering it on a folder would name the wrong thing and destroy an account. The
                 selector keys off SidebarItem.AccountId. Both levels of the hierarchy draw through
                 it, a folder is a child of its account's item via MenuItemsSource.

                 {Binding}, NOT {x:Bind}, these are the only two in the app, so the reason has to
                 live here. x:Bind compiles a cast of the template's data root to its x:DataType, and
                 NavigationView hands an item template a raw WinRT.IInspectable rather than the
                 projected object: every row threw InvalidCastException before the sidebar drew a
                 single entry. The identical pattern over a ListView is fine (MailListView.xaml,
                 x:DataType="vm:MailRow"), so this is NavigationView's item plumbing and not the
                 types, do not "fix" it back to x:Bind on the strength of the rest of the file.
                 {Binding} resolves against the DataContext by reflection and does not care. -->
            <NavigationView.MenuItemTemplateSelector>
                <views:SidebarItemTemplateSelector>
                    <views:SidebarItemTemplateSelector.Plain>
                        <DataTemplate>
                            <!-- AutomationProperties.Name is REQUIRED here, not decoration. A
                                 NavigationViewItem derives its spoken name from Content, and this
                                 template's Content is a Grid rather than the label string, so
                                 without this the row has no name at all: invisible to a screen
                                 reader, and unfindable by every automation lookup, while looking
                                 exactly right on screen. The UI suite caught precisely that. -->
                            <NavigationViewItem
                                Tag="{Binding Tag}"
                                SelectsOnInvoked="{Binding SelectsOnInvoked}"
                                AutomationProperties.Name="{Binding Content}"
                                AutomationProperties.AutomationId="{Binding AutomationId}">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="{Binding Glyph}" />
                                </NavigationViewItem.Icon>
                                <!-- The label and its unread count, rather than a bare Content
                                     string: a folder badge sits at the trailing edge, which needs a
                                     two-column row.

                                     Not a NavigationViewItem.InfoBadge, that slot is a filled
                                     accent pill, which is right for the account row's outage dot and
                                     far too loud repeated down twenty folders. Outlook draws a plain
                                     accent number, and so do we.

                                     Hidden at zero, which deliberately also hides "this provider
                                     reports no count" (Gmail today): both mean we have nothing
                                     truthful to show, and a 0 badge would claim we had looked.
                                     AutomationProperties.Name carries the localized sentence,
                                     because "Inbox, 545" read aloud is a position in a list. -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding Content}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding UnreadText}"
                                        Visibility="{Binding ShowUnread, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="{Binding UnreadLabel}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </NavigationViewItem>
                        </DataTemplate>
                    </views:SidebarItemTemplateSelector.Plain>
                    <views:SidebarItemTemplateSelector.Account>
                        <DataTemplate>
                            <!-- IsExpanded is TwoWay so collapsing an account by hand sticks rather
                                 than being overwritten by the next background sync. -->
                            <!-- The address in full on hover. The pane is draggable now, but an
                                 address can always outrun whatever width the user picked, and a
                                 row reading "eva.jansen@example.c…" is exactly when they need to
                                 know which account it is. -->
                            <NavigationViewItem
                                Content="{Binding Content}"
                                Tag="{Binding Tag}"
                                ToolTipService.ToolTip="{Binding Content}"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                MenuItemsSource="{Binding Children}">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="{Binding Glyph}" />
                                </NavigationViewItem.Icon>
                                <!-- A warning badge when this account's server couldn't be reached
                                     on its last sync (while online), a per-account outage, distinct
                                     from the offline banner. Always in the template and collapsed
                                     when there is no outage, so an outage costs no container work. -->
                                <NavigationViewItem.InfoBadge>
                                    <InfoBadge Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVisibility}}">
                                        <InfoBadge.IconSource>
                                            <SymbolIconSource Symbol="Important" />
                                        </InfoBadge.IconSource>
                                    </InfoBadge>
                                </NavigationViewItem.InfoBadge>
                                <!-- No ContextFlyout here: a NavigationViewItem declared in an item
                                     template never receives the right-click, so one set here opens
                                     for nobody. "Remove account" is raised from the NavigationView's
                                     own ContextRequested instead, MainWindow.Sidebar.cs. -->
                            </NavigationViewItem>
                        </DataTemplate>
                    </views:SidebarItemTemplateSelector.Account>
                </views:SidebarItemTemplateSelector>
            </NavigationView.MenuItemTemplateSelector>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The shell's banner strip. Every bar here carries BOTH IsOpen and Visibility
                     off the same flag, and the pair is load-bearing: a closed InfoBar does not
                     collapse itself, it stays visible at zero size, so its 12px top margin is
                     still reserved, and five silent bars cost 60px across the top of every detail
                     surface. IsOpen alone leaves that hole; Visibility alone would announce all
                     five to a screen reader at launch and never again.

                     Shown() rather than the BoolToVisibility converter below: an x:Bind converter
                     needs a FrameworkElement to resolve the resource against, and this file's root
                     is a Window, the generated code fails to compile, naming a line in
                     MainWindow.g.cs. An x:Bind FUNCTION has no such constraint. -->
                <StackPanel Grid.Row="0" x:Name="ContentBanners">
                    <!-- The device has no network: the mail on screen is the last-synced copy.
                         Non-closable, it clears itself when connectivity returns and the core
                         auto-refreshes. -->
                    <InfoBar
                        Margin="12,12,12,0"
                        IsOpen="{x:Bind Model.IsOffline, Mode=OneWay}"
                        Visibility="{x:Bind Shown(Model.IsOffline), Mode=OneWay}"
                        IsClosable="False"
                        Severity="Warning"
                        Message="{x:Bind l10n:L10n.ConnectivityOfflineBanner()}" />

                    <!-- One or more accounts can't reach their server (a provider outage, a stale
                         password): a friendly, self-healing banner naming the affected accounts,
                         with a "Details" flyout for the raw error and a "Try again" that re-dials.
                         Non-closable, it clears itself the moment the accounts reconnect. -->
                    <InfoBar
                        Margin="12,12,12,0"
                        IsOpen="{x:Bind Model.HasConnectionIssues, Mode=OneWay}"
                        Visibility="{x:Bind Shown(Model.HasConnectionIssues), Mode=OneWay}"
                        IsClosable="False"
                        Severity="Warning"
                        Message="{x:Bind Model.ConnectionIssuesText, Mode=OneWay}">
                        <InfoBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,12">
                                <Button Content="{x:Bind l10n:L10n.ConnectivityDetails()}">
                                    <Button.Flyout>
                                        <Flyout>
                                            <TextBlock Text="{x:Bind Model.ConnectionIssuesDetail, Mode=OneWay}"
                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                                       MaxWidth="520"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Content="{x:Bind l10n:L10n.ActionRetry()}" Click="OnRetryConnections" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>

                    <!-- The device moved to a different zone than the active one: offer to switch. -->
                    <InfoBar
                        Margin="12,12,12,0"
                        IsOpen="{x:Bind Model.HasPendingZone, Mode=OneWay}"
                        Visibility="{x:Bind Shown(Model.HasPendingZone), Mode=OneWay}"
                        IsClosable="False"
                        Severity="Informational"
                        Title="{x:Bind l10n:L10n.TzChangedTitle()}"
                        Message="{x:Bind Model.ZonePromptText, Mode=OneWay}">
                        <InfoBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,12">
                                <Button Content="{x:Bind l10n:L10n.ActionUpdate()}" Click="OnAcceptZone" />
                                <Button Content="{x:Bind Model.KeepZoneText, Mode=OneWay}" Click="OnDismissZone" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>

                    <!-- The calendar server stored the answer and then reported it could not tell
                         the organiser (RFC 6638 §3.2.9): offer to email it ourselves. A bar rather
                         than the modal macOS and Android raise, the same two decisions, in this
                         shell's chrome. It is also the safer surface here: WinUI allows exactly one
                         ContentDialog at a time and silently drops a second, so a question arriving
                         while another dialog was open would have been thrown away while the core
                         went on holding it. IsClosable is off because the core owns both edges, it
                         clears the question itself, and a bar the user could close would leave one
                         standing that nobody can answer. -->
                    <InfoBar
                        Margin="12,12,12,0"
                        IsOpen="{x:Bind Model.HasReplyPrompt, Mode=OneWay}"
                        Visibility="{x:Bind Shown(Model.HasReplyPrompt), Mode=OneWay}"
                        IsClosable="False"
                        Severity="Warning"
                        Title="{x:Bind l10n:L10n.InvitationReplyUndeliveredTitle()}"
                        Message="{x:Bind Model.ReplyPromptText, Mode=OneWay}">
                        <InfoBar.Content>
                            <StackPanel Spacing="8" Margin="0,8,0,12">
                                <CheckBox x:Name="RememberReplyChoice"
                                          Content="{x:Bind l10n:L10n.InvitationReplyUndeliveredRemember()}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{x:Bind l10n:L10n.InvitationReplyUndeliveredSend()}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="OnSendUndeliveredReply" />
                                    <Button Content="{x:Bind l10n:L10n.InvitationReplyUndeliveredDismiss()}"
                                            Click="OnDismissUndeliveredReply" />
                                </StackPanel>
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>
                    <!-- The message went out; only the sender's copy is missing. Warning, never
                         Error: an error severity reads as "not sent" and invites a re-send of mail
                         the recipients already have. IsClosable is off for the same reason as
                         above, the core owns both edges of the question. -->
                    <InfoBar
                        Margin="12,12,12,0"
                        IsOpen="{x:Bind Model.HasUnfiledCopy, Mode=OneWay}"
                        Visibility="{x:Bind Shown(Model.HasUnfiledCopy), Mode=OneWay}"
                        IsClosable="False"
                        Severity="Warning"
                        Title="{x:Bind l10n:L10n.UnfiledCopyTitle()}"
                        Message="{x:Bind Model.UnfiledCopyText, Mode=OneWay}">
                        <InfoBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,12">
                                <Button Content="{x:Bind l10n:L10n.UnfiledCopyRetry()}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind Model.UnfiledCopyActionable, Mode=OneWay}"
                                        Click="OnRetryUnfiledCopy" />
                                <Button Content="{x:Bind l10n:L10n.UnfiledCopyDismiss()}"
                                        IsEnabled="{x:Bind Model.UnfiledCopyActionable, Mode=OneWay}"
                                        Click="OnDismissUnfiledCopy" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>
                </StackPanel>

                <!-- The detail area: the calendar agenda, or the three-pane mail view, the
                     message list and the reading pane side by side (the NavigationView pane is
                     the sidebar), with the open message reflected inline beside the list. -->
                <Grid Grid.Row="1">
                    <!-- Mail: list | draggable divider | reading pane. Hidden as a whole for the
                         calendar. The divider is a ColumnSplitter: dragging it resizes the list
                         column (pinned to pixels on first drag) while the reading column, the lone
                         star, absorbs the remainder, clamped so neither pane drops below MinWidth.
                         See OnSplitter* in the code-behind. -->
                    <Grid x:Name="MailGrid" SizeChanged="OnMailGridSizeChanged"
                          Visibility="{x:Bind Model.MailVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ListColumn" Width="2*" MinWidth="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="ReadingColumn" Width="3*" MinWidth="380" />
                        </Grid.ColumnDefinitions>
                        <views:MailListView x:Name="MailView" Grid.Column="0" />
                        <controls:ColumnSplitter x:Name="PaneSplitter" Grid.Column="1" Width="8"
                                Background="Transparent"
                                PointerPressed="OnSplitterPressed" PointerMoved="OnSplitterMoved"
                                PointerReleased="OnSplitterReleased" PointerCaptureLost="OnSplitterCaptureLost">
                            <Border Width="1" HorizontalAlignment="Center"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </controls:ColumnSplitter>
                        <views:ReadingView x:Name="ReadingPanel" Grid.Column="2" />
                        <!-- The composer takes the reading pane's slot while a draft is open,
                             behind the same splitter, so the sidebar and the message list stay
                             live and clickable (they were blacked out by the old modal). Exactly
                             one of the two is visible; MainWindow.Compose.cs owns the swap. -->
                        <ContentControl x:Name="ComposerHost" Grid.Column="2"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                    </Grid>
                    <views:CalendarView
                        x:Name="CalendarDetail"
                        Visibility="{x:Bind Model.CalendarVisibility, Mode=OneWay}" />
                    <!-- Contacts follows the MAIL layout, not the calendar's: a list of people is
                         something you pick one of, where the calendar is one wide grid with nothing
                         to select beside it. -->
                    <views:ContactsView
                        x:Name="ContactsDetail"
                        Visibility="{x:Bind Model.ContactsVisibility, Mode=OneWay}" />
                </Grid>

                <!-- Drag the pane|content boundary to widen the folder tree, so a long account
                     address is readable rather than clipped mid-domain. The twin of the
                     list|reading splitter below it, down to the persisted width.

                     It lives HERE, as the last child of the NavigationView's content and pinned to
                     its left edge, because that edge IS the pane boundary, the content area starts
                     at OpenPaneLength. Declared last so it wins the hit test over the views beneath
                     it; last in the content rather than in the pane because a NavigationView clips
                     its pane, so a grip on that side would be half unhittable.

                     Deliberately invisible: NavigationView already draws the divider, and a second
                     hairline on top of it reads as a rendering bug. The resize cursor is the
                     affordance, which is what File Explorer's own navigation pane does. -->
                <controls:ColumnSplitter
                    x:Name="SidebarSplitter"
                    Grid.Row="0" Grid.RowSpan="2"
                    Width="8"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    AutomationProperties.AutomationId="SidebarSplitter"
                    AutomationProperties.Name="{x:Bind l10n:L10n.A11yResizeFolderPane()}"
                    PointerPressed="OnSidebarSplitterPressed"
                    PointerMoved="OnSidebarSplitterMoved"
                    PointerReleased="OnSidebarSplitterReleased"
                    PointerCaptureLost="OnSidebarSplitterCaptureLost" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
