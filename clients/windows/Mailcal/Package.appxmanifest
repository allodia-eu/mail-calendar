<?xml version="1.0" encoding="utf-8"?>

<!-- The MSIX package identity + tile/store metadata for the Store build (package.ps1 /
     -p:Packaged=true). Unused by the unpackaged dev loop.

     Every name here is the UNBRANDED default (docs/branding.md). A Store build is not made from
     this file as it stands: package.ps1 rewrites the identity and the display names from the
     brand before the build and restores these bytes after, because the values a Store demands are
     a reservation held in Partner Center (Package/Identity/@Name, Package/Identity/@Publisher
     "CN=<account GUID>", Properties/PublisherDisplayName) and must match it exactly or the upload
     is rejected on ingestion. What stays here is a package that builds, installs and runs, it is
     simply nobody's product. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="org.mailcal.client"
    Publisher="CN=MailCal"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>MailCal</DisplayName>
    <!-- Must match the verified publisher display name on the Partner Center account EXACTLY, or
         the Store rejects the upload on ingestion. package.ps1 supplies it. -->
    <PublisherDisplayName>MailCal</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Floor = Windows 10 2004 (matches TargetPlatformMinVersion); tested up to 24H2. -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="MailCal"
        Description="Mail and calendar that keep your data in your jurisdiction."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Images\Wide310x150Logo.png"
          Square71x71Logo="Images\Square71x71Logo.png"
          Square310x310Logo="Images\Square310x310Logo.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>

      <!-- The custom URI scheme every browser sign-in redirects back to: Microsoft 365
           (<app-id>://auth) and JMAP (<app-id>://jmap-oauth). Windows registers a protocol per
           SCHEME, not per URL, so this one declaration covers both, the redirect's host is what
           tells the two flows apart at delivery (ProtocolAuthCallback). Declaring it here
           registers the protocol on install for packaged/Store builds. The unpackaged dev loop
           registers a DIFFERENT scheme at runtime, <app-id>.dev
           (Program.RegisterProtocolForUnpackaged), because a developer's machine has the Store
           build installed too, and two claimants on one scheme means Windows can only ask the user
           which app should receive a redirect carrying a live auth code. Must match
           OAuthScheme.Packaged and the Azure "Mobile and desktop applications" redirect,
           character-for-character; Azure lists the .dev form as well. -->
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="org.mailcal.client">
            <uap:DisplayName>MailCal sign-in</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- Mail links. Declaring `mailto` is what puts the app in Windows'
             Default apps list and in a browser's "open with" prompt, so a user can choose it and
             have an email address on a web page open the composer here. It does NOT seize the
             association: Windows asks the user, and until they choose, the current default keeps
             handling links.

             The URI is decoded by the shared core, which honours only To/Cc/Bcc/Subject/Body and
             drops every other header a link may name (docs/composer-security.md, Gate 12), so
             this declaration exposes a pre-filled composer, never a send. Name must equal
             MailLink.Scheme; MailLinkTests asserts the two against each other. The unpackaged dev
             build deliberately does NOT register this (Program.RegisterProtocolForUnpackaged): a
             developer's machine has a real mail client, and a debug build quietly becoming a
             candidate for it is not a trade the dev loop should make, it takes its mail links on
             the command line instead. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="mailto">
            <uap:DisplayName>MailCal</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- Sharing into the app: "share this by email" from Windows' own share sheet
             (docs/os-integration.md; docs/composer-security.md, Gate 13). The app appears
             wherever Windows offers to share, and a composer opens holding what was shared.

             `SupportsAnyFileType` on purpose: what we do with a shared file is attach it, and a
             mail client that took a PDF but not a `.dwg` would be refusing on a distinction it
             never acts on. `Text` and `WebLink` ride the same extension, which is how a shared
             selection or URL reaches the body.

             The payload is decoded by the shared core (`PrefillFromShare`), which names and types
             every file and reports what it would not attach. A share pre-fills an editable
             composer, never a send, and it cannot address a message: only shared text that is
             itself a mail link reaches the recipient fields. -->
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget>
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
            <uap:DataFormat>Text</uap:DataFormat>
            <uap:DataFormat>WebLink</uap:DataFormat>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>

        <!-- The MCP stdio relay (docs/mcp.md), reachable by name. An MCP client spawns its server
             as a child process, and a packaged app installs under C:\Program Files\WindowsApps\,
             whose ACLs deny execution to an ordinary process, so a config naming an absolute path
             in there would look right and fail with an access denial the user cannot act on. An App
             Execution Alias is what this mechanism is for: it installs a launcher into
             %LOCALAPPDATA%\Microsoft\WindowsApps, which is on the user's PATH, so the bare name
             resolves. The alias MUST equal McpEndpoint.RelayFileName, which is what the generated
             config snippet emits as `command`; McpEndpointTests asserts that against this file.
             The unpackaged dev build has no manifest and is reached by its absolute path instead.
             EntryPoint is Windows.FullTrustApplication because the relay is a plain Win32 exe, not
             a WinRT app, it needs the user's own token to open the app's named pipe. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="allodia-mcp.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="allodia-mcp.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Packaged Win32 (WinUI 3) desktop apps run outside the app container; runFullTrust is
         the standard, Store-auto-approved capability for them. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Outbound network for mail/calendar provider sync (every dispatch still passes the
         in-process JurisdictionGate before data leaves, the OS capability is orthogonal). -->
    <Capability Name="internetClient" />
  </Capabilities>

</Package>
