<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Allodia.Mailcal.Views.RecipientField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Allodia.Mailcal.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:vm="using:Allodia.Mailcal.ViewModels"
    xmlns:l10n="using:Allodia.Mailcal">

    <!-- One recipient field (To / Cc / Bcc): the finished addresses as pills, the one being typed as
         text, and the autosuggest list floating over what follows.

         The field's value stays a single comma-separated string owned by the composer, because that
         is what the send path parses, the pills are a RENDERING of it, not a second source of
         truth. So there is no state to keep in sync and nothing can be on screen that would not be
         sent. Services/RecipientTokens.cs owns the string <-> (pills, token) split in pure functions
         Mailcal.Tests drives directly. -->
    <UserControl.Resources>
        <!-- A finished recipient's pill, built in code (RecipientField.xaml.cs) because it shares
             the line with the input. A style rather than a brush, so the fill follows the theme. -->
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,2,2,2" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- One line per field, as a mail client lays out its header: the label in a column the composer
         lines up across From, To, Cc, Bcc and Subject, then one underlined box holding the finished
         addresses as pills with the one being typed after them, wrapping onto further lines when
         there are more than fit, then whatever the composer hung off the field (the To row carries
         the Cc/Bcc chevron; Cc and Bcc carry nothing).

         The Popup is a child of this Grid too, and takes no layout space in it. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LabelColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LabelText" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,12,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- The underline is the field's edge, and it turns to the accent while the input has focus
             (Controls/HeaderField.cs): the input itself draws no box of its own, so the pills
             and the text are visibly one field. -->
        <Grid x:Name="Field" Grid.Column="1" SizeChanged="OnFieldSizeChanged"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- A FlowPanel has no automation peer, so the pills are reached through their own text
                 and their remove buttons, each of which names the recipient it would remove. The
                 input is its last child and fills what is left of its line (FillLast). -->
            <controls:FlowPanel x:Name="Line" Spacing="4" FillLast="120">
                <TextBox x:Name="Input" TextChanged="OnInputChanged" KeyDown="OnInputKeyDown"
                         LosingFocus="OnInputLosingFocus" />
            </controls:FlowPanel>
            <!-- Bottom-aligned, so it sits on the input's line however many lines of pills there
                 are: the input is always the last child, so its line is the last one. No column
                 spacing: an Auto column spaces even when it is empty, which would narrow Cc and
                 Bcc against To for a control they do not have. The margin rides on the content. -->
            <ContentPresenter x:Name="TrailingHost" Grid.Column="1" VerticalAlignment="Bottom" />
            <Rectangle x:Name="FocusLine" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom"
                       Margin="0,0,0,-1" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                       Visibility="Collapsed" />
        </Grid>

        <!-- The suggestions float OVER what follows rather than sitting in the layout.

             Inline, the list was a sibling in the layout: it appeared and disappeared on every
             keystroke and took ~160px with it, so Cc, Bcc, the editor and the Send row all jumped
             down and back while the user was still typing the first recipient. A Popup takes no
             layout space at all, the element below is where it was before anyone started typing.

             Which is also why the surface must be OPAQUE and shadowed: it now covers live content,
             and the semi-transparent control fill it used to carry would render two texts on top of
             each other. -->
        <primitives:Popup x:Name="SuggestionPopup"
                          PlacementTarget="{x:Bind Field}"
                          DesiredPlacement="BottomEdgeAlignedLeft">
            <Border x:Name="SuggestionSurface"
                    Background="{ThemeResource FlyoutPresenterBackground}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="1"
                    Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <!-- Stale matches stay on screen for the debounce window rather than blanking, which
                     is what makes the list feel steady instead of flickering on every character. The
                     count is capped in the core, not here. -->
                <ListView x:Name="SuggestionList" MaxHeight="160"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSuggestionPicked"
                          AutomationProperties.AutomationId="RecipientSuggestions"
                          AutomationProperties.Name="{x:Bind l10n:L10n.ComposeSuggestions()}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecipientSuggestionItem">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind DisplayName}" Visibility="{x:Bind NameVisibility}"
                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Email}" MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </primitives:Popup>
    </Grid>
</UserControl>
