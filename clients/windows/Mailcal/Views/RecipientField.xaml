<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Allodia.Mailcal.Views.RecipientField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Allodia.Mailcal.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:vm="using:Allodia.Mailcal.ViewModels"
    xmlns:l10n="using:Allodia.Mailcal">

    <!-- One recipient field (To / Cc / Bcc): the finished addresses as pills, the one being typed as
         text, and the autosuggest list floating over what follows.

         The field's value stays a single comma-separated string owned by the composer, because that
         is what the send path parses, the pills are a RENDERING of it, not a second source of
         truth. So there is no state to keep in sync and nothing can be on screen that would not be
         sent. Services/RecipientTokens.cs owns the string <-> (pills, token) split in pure functions
         Mailcal.Tests drives directly. -->
    <StackPanel Spacing="4">
        <TextBlock x:Name="LabelText" />

        <!-- A plain ItemsControl has no automation peer, so this container is NOT a node in the UIA
             tree and cannot be scoped to by id, the pills are reached through their own text and
             their remove buttons, each of which names the recipient it would remove. -->
        <ItemsControl x:Name="Pills" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:FlowPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecipientPillItem">
                    <Border CornerRadius="12" Padding="8,2,2,2"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="{x:Bind Text}" VerticalAlignment="Center"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" MaxWidth="240"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button Tag="{x:Bind Index}" Click="OnRemoveRecipient"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4" MinWidth="0"
                                    AutomationProperties.Name="{x:Bind RemoveLabel}"
                                    ToolTipService.ToolTip="{x:Bind RemoveLabel}">
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The input, and whatever control the composer hung off it (the To row carries the Cc/Bcc
             chevron; Cc and Bcc carry nothing).

             The trailing control sits in the input's OWN row, which is what keeps the two aligned.
             Beside the whole field it drifted: this StackPanel's Spacing adds a gap after the input
             for the closed Popup below, so the field's bottom edge is 4epx under the input's and a
             bottom-aligned control was drawn 4epx low, and lower still once pills appear. Nothing
             here needs the composer to know that.

             No ColumnSpacing: an Auto column spaces even when it is empty, which would narrow Cc
             and Bcc against To for a control they do not have. The margin rides on the content. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" Grid.Column="0" TextChanged="OnInputChanged" KeyDown="OnInputKeyDown"
                     LosingFocus="OnInputLosingFocus" SizeChanged="OnInputSizeChanged" />
            <ContentPresenter x:Name="TrailingHost" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>

        <!-- The suggestions float OVER what follows rather than sitting in the layout.

             Inline, the list was a sibling in this StackPanel: it appeared and disappeared on every
             keystroke and took ~160px with it, so Cc, Bcc, the editor and the Send row all jumped
             down and back while the user was still typing the first recipient. A Popup takes no
             layout space at all, the element below is where it was before anyone started typing.

             Which is also why the surface must be OPAQUE and shadowed: it now covers live content,
             and the semi-transparent control fill it used to carry would render two texts on top of
             each other. -->
        <primitives:Popup x:Name="SuggestionPopup"
                          PlacementTarget="{x:Bind Input}"
                          DesiredPlacement="BottomEdgeAlignedLeft">
            <Border x:Name="SuggestionSurface"
                    Background="{ThemeResource FlyoutPresenterBackground}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="1"
                    Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <!-- Stale matches stay on screen for the debounce window rather than blanking, which
                     is what makes the list feel steady instead of flickering on every character. The
                     count is capped in the core, not here. -->
                <ListView x:Name="SuggestionList" MaxHeight="160"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSuggestionPicked"
                          AutomationProperties.AutomationId="RecipientSuggestions"
                          AutomationProperties.Name="{x:Bind l10n:L10n.ComposeSuggestions()}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecipientSuggestionItem">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind DisplayName}" Visibility="{x:Bind NameVisibility}"
                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Email}" MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </primitives:Popup>
    </StackPanel>
</UserControl>
