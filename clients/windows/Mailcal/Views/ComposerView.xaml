<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Allodia.Mailcal.Views.ComposerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:layout="using:Allodia.Mailcal.Controls"
    xmlns:views="using:Allodia.Mailcal.Views"
    xmlns:l10n="using:Allodia.Mailcal">

    <!-- The composer as it lives in the reading-pane slot: FLUID, not the fixed 620x660 the
         ContentDialog carried. The pane is user-resizable down to its 380 epx MinWidth (the
         list|reading splitter), so a fixed width would clip its own right edge exactly as the
         dialog once did. Everything stretches; the editor is the lone star row and absorbs the
         height. -->
    <!-- A dropped file is resolved natively (ComposerView.Drop.cs): web code sees a File with no
         path, so only the host can hand the bytes to Rust and list the file for removal. -->
    <Grid Padding="16" RowSpacing="10" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

        <!-- The header: From, To (with Cc and Bcc behind its chevron) and Subject, one line each with
             the label in a column the rows share, the way a mail client lays out a message's header
             (ComposerView.Header.cs lines the labels up). -->
        <StackPanel Grid.Row="1" Spacing="4">
            <!-- Which account the message is sent from. The core sends as, and through, that account
                 (its identity AND its outbox), so this is an account picker, not a free-text From
                 header. With one account there is nothing to choose, so the code-behind shows the
                 read-only FromAddress instead of a menu onto a single item (the Apple client's
                 FromAccountField does the same); the address stays visible either way. FromBox is
                 populated and selected regardless, hidden or not, it is what the send reads its
                 account from, so the sender never falls back to whatever the core would derive.
                 The label is SendLabel, `Name <address>`, which is how the recipient will read it
                 (docs/sending.md); an account with no name shows its address alone. -->
            <Grid MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FromLabelColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FromLabel" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="FromBox" Grid.Column="1" HorizontalAlignment="Stretch"
                          DisplayMemberPath="SendLabel" SelectionChanged="OnFromChanged" />
                <TextBlock x:Name="FromAddress" Grid.Column="1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </Grid>

            <!-- To/Cc/Bcc: each finished address is a removable pill, the one being typed stays text,
                 and typing offers ranked suggestions from synced contacts AND from people the user
                 has written to (docs/contacts.md §4). The labels and automation ids are set in the
                 code-behind rather than bound here, so the control needs no dependency property for
                 a string that never changes after Init.

                 Cc and Bcc live behind the chevron on the To row, as they do on Android and as Gmail
                 and Thunderbird draw them, so the header a message usually needs is From, To,
                 Subject. -->
            <views:RecipientField x:Name="ToField">
                <views:RecipientField.Trailing>
                    <ToggleButton x:Name="CcBccToggle" MinWidth="0" Padding="10,6" Margin="8,0,0,2"
                                  Checked="OnToggleCcBcc" Unchecked="OnToggleCcBcc"
                                  AutomationProperties.AutomationId="CcBccToggle"
                                  AutomationProperties.Name="{x:Bind l10n:L10n.ComposeShowCcBcc()}"
                                  ToolTipService.ToolTip="{x:Bind l10n:L10n.ComposeShowCcBcc()}">
                        <FontIcon x:Name="CcBccChevron" Glyph="&#xE70D;" FontSize="12" />
                    </ToggleButton>
                </views:RecipientField.Trailing>
            </views:RecipientField>
            <!-- One panel rather than two rows, so collapsing it leaves no gap behind. -->
            <StackPanel x:Name="CcBccPanel" Spacing="4" Visibility="Collapsed">
                <views:RecipientField x:Name="CcField" />
                <views:RecipientField x:Name="BccField" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SubjectLabelColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SubjectLabel" VerticalAlignment="Top" Margin="0,6,12,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid Grid.Column="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="0,0,0,1">
                    <TextBox x:Name="SubjectBox" TextChanged="OnHeaderChanged" />
                    <Rectangle x:Name="SubjectFocusLine" Height="2" VerticalAlignment="Bottom"
                               Margin="0,0,0,-1" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>
        </StackPanel>

        <!-- The per-message quote-style toggle. Shown only for a reply/forward that carries a
             quoted original AND when the user opted into per-message styling in Settings, off by
             default, so an ordinary reply just uses the app default. Flipping it re-styles the
             quote in place; it does not change the persisted default. -->
        <StackPanel x:Name="QuoteStylePanel" Grid.Row="2" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
            <TextBlock Text="{x:Bind l10n:L10n.QuoteStyleLabel()}" VerticalAlignment="Center" />
            <RadioButton x:Name="QuoteIndentedRadio" GroupName="QuoteStyle"
                         Content="{x:Bind l10n:L10n.QuoteStyleIndented()}" Checked="OnQuoteStyleChanged" />
            <RadioButton x:Name="QuoteLineHeaderRadio" GroupName="QuoteStyle"
                         Content="{x:Bind l10n:L10n.QuoteStyleLineHeader()}" Checked="OnQuoteStyleChanged" />
        </StackPanel>

        <Border x:Name="EditorFrame" Grid.Row="3" SizeChanged="OnEditorFrameSizeChanged" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <controls:WebView2 x:Name="Editor" />
        </Border>

        <StackPanel Grid.Row="4" Spacing="6">
            <!-- A drafted reply's summary and checklist (docs/ai.md, "Where they show"), between
                 the editor and the action row. Never part of the mail: it is not in the editor.
                 Filled in code, per draft (ComposerView.DraftChecklist.cs). -->
            <Expander x:Name="DraftCard" Visibility="Collapsed" IsExpanded="True"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      AutomationProperties.AutomationId="DraftCard" />
            <!-- The composer's action row: things you do TO the message, as opposed to the
                 From/To/Cc fields you address it with. That is why Signature sits here and not
                 among them (docs/signatures.md), it is the Windows counterpart of the action bar
                 macOS/iOS put above the editor and of Android's app bar. It stays hidden until the
                 library holds something, since a picker offering only "None" says nothing; the
                 current choice shows as a checkmark inside the menu rather than on the button, so
                 the row stays a row of verbs. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Bind l10n:L10n.ActionAttach()}" Click="OnAttachFiles" />
                <Button x:Name="RemoveAttachmentButton" Content="{x:Bind l10n:L10n.ActionRemove()}"
                        Click="OnRemoveAttachment" IsEnabled="False" />
                <DropDownButton x:Name="SignatureButton" Visibility="Collapsed"
                                Content="{x:Bind l10n:L10n.ComposeSignatureLabel()}">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SignatureMenu" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <!-- Draft a reply (docs/ai.md), beside Signature: another thing done TO the
                     message. Drawn only on a reply or reply-all while AI has somewhere to go, and
                     disabled while the sender's account has no writing style. A disabled control
                     shows no tooltip of its own, so the reason hangs on this host, whose
                     transparent background makes it hit-testable (ComposerView.DraftReply.cs). The
                     flyout's text is set in code, like the signature menu's. -->
                <Grid x:Name="DraftReplyHost" Visibility="Collapsed" Background="Transparent">
                    <Button x:Name="DraftReplyButton"
                            AutomationProperties.AutomationId="DraftReplyButton"
                            Content="{x:Bind l10n:L10n.ComposerDraftReply()}">
                        <Button.Flyout>
                            <Flyout x:Name="DraftReplyFlyout">
                                <StackPanel Width="320" Spacing="10">
                                    <TextBox x:Name="DraftIntentBox"
                                             AutomationProperties.AutomationId="DraftIntentBox" />
                                    <layout:FlowPanel Spacing="6">
                                        <Button x:Name="DraftChipYes" Click="OnDraftChip" />
                                        <Button x:Name="DraftChipNo" Click="OnDraftChip" />
                                        <Button x:Name="DraftChipMoreInfo" Click="OnDraftChip" />
                                        <Button x:Name="DraftChipLater" Click="OnDraftChip" />
                                    </layout:FlowPanel>
                                    <Button x:Name="DraftCreateButton" HorizontalAlignment="Right"
                                            AutomationProperties.AutomationId="DraftCreateButton"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="OnDraftCreate" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </StackPanel>
            <!-- On a line of its own rather than in the row above, which is already at the pane's
                 narrowest width. The composer stays usable while a draft is on its way. -->
            <StackPanel x:Name="DraftingRow" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                <ProgressRing x:Name="DraftingRing" Width="16" Height="16" IsActive="False" />
                <TextBlock Text="{x:Bind l10n:L10n.ComposerDrafting()}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Stands until the next draft or the send, which closes the composer. A draft whose
                 checklist names its gaps says so in the card instead. -->
            <TextBlock x:Name="DraftBracketsHint" Visibility="Collapsed" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind l10n:L10n.ComposerDraftCheckBrackets()}" />
            <ListView x:Name="AttachmentList" MaxHeight="92" SelectionMode="Single"
                      DisplayMemberPath="DisplayName" SelectionChanged="OnAttachmentSelectionChanged" />
        </StackPanel>

        <TextBlock x:Name="PrepareError" Grid.Row="5" Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Text="{x:Bind l10n:L10n.ComposePrepareError()}" />

        <!-- Send / Cancel. These were ContentDialog chrome (PrimaryButton / CloseButton) and the
             send hung off args.Cancel in the dialog's button handler; a pane has no chrome, so the
             composer now owns its own action row. -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <!-- Named like its sibling so a test can press it without knowing the app's language:
                 a harness run is in whatever the developer prefers, not a pinned locale. -->
            <Button x:Name="CancelButton" Content="{x:Bind l10n:L10n.ActionCancel()}" Click="OnCancel" />
            <Button x:Name="SendButton" Content="{x:Bind l10n:L10n.ActionSend()}"
                    Style="{StaticResource AccentButtonStyle}" Click="OnSend" IsEnabled="False" />
        </StackPanel>
    </Grid>
</UserControl>
