<?xml version="1.0" encoding="utf-8"?>
<!--
  The window's one notice bar (docs/notices.md): the first notice that belongs to the screen on
  show, its one action, and every other notice behind a single "more" button. Never a second bar.

  Drawn from code (NoticeBar.xaml.cs) rather than bound, because what it shows is a choice made
  over the whole list on each snapshot and each change of screen, and its flyout is rebuilt from
  that list when it opens.

  Visibility as well as IsOpen: a closed InfoBar stays visible at zero size, so its top margin
  would still push every screen down (MainWindow.xaml's banner strip carries the full note).
-->
<UserControl
    x:Class="Allodia.Mailcal.Views.NoticeBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <InfoBar
        x:Name="Bar"
        Margin="12,12,12,0"
        IsOpen="False"
        Visibility="Collapsed"
        AutomationProperties.AutomationId="NoticeBar"
        CloseButtonClick="OnClose">
        <InfoBar.ActionButton>
            <Button x:Name="ActionButton"
                    AutomationProperties.AutomationId="NoticeAction"
                    Click="OnAction" />
        </InfoBar.ActionButton>
        <InfoBar.Content>
            <Button x:Name="MoreButton"
                    Margin="0,0,0,8"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="NoticeMore">
                <Button.Flyout>
                    <Flyout x:Name="MoreFlyout" Opening="OnMoreOpening">
                        <ScrollViewer MaxHeight="480" MaxWidth="520">
                            <StackPanel x:Name="MoreList"
                                        Spacing="16"
                                        AutomationProperties.AutomationId="NoticeList" />
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </InfoBar.Content>
    </InfoBar>
</UserControl>
