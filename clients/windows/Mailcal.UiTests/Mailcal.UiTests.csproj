<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows client's UI suites: assertions against the RUNNING app, through its in-process test
       agent (Mailcal/Services/TestAgent.cs) for finding and acting, and through real pointer and
       keyboard input for presses that have to be presses. README.md says how to run them.

       It references nothing of the app: the agent is reached over a named pipe, so this builds
       without WinUI and runs against whichever Debug build is newest. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Allodia.Mailcal.UiTests</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Warnings are hard errors, as they are in the app (Mailcal.csproj). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Screen pixels, for the suites that assert on what is drawn. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- System.Windows.Automation, for the few things the system draws outside the XAML tree. -->
    <UseWPF>true</UseWPF>
    <!-- So the gate can compile it on a Linux or macOS host, as it does Mailcal.Tests. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF leaves these out of the implicit usings, for types of its own this project never uses. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
