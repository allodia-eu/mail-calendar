<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for the AppStream metainfo a software centre reads. The placeholders are filled by
  scripts/dev/flatpak_metadata.py, which takes the copy from branding/<brand>-listing.md and the release
  history from /VERSION plus docs/changelog/released/; so no name, sentence, version or date is
  ever hand-edited here. The generated file is not committed; the Flatpak build emits it.
-->
<component type="desktop-application">
  <id>@APP_ID@</id>

  <!-- CC0 on this file, not on the app: it says a software centre may redistribute the listing.

       The app's own licence is NOT a literal here, for the same reason the name and the id are
       not: one template describes two artifacts. A build from source links nothing but the GPL
       application; a build carrying the Allodia registration links the source-available crate the
       registration exists for, and the two cannot honestly claim the same licence.
       `flatpak_metadata.project_license()` derives it from the registration, exactly as
       `core_cargo_features` derives the cargo feature from it, so the field and the binary cannot
       disagree. -->
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>@PROJECT_LICENSE@</project_license>

  <name>@NAME@</name>
@SUMMARIES@
@DESCRIPTION@

  <developer id="eu.allodia">
    <name>Allodia</name>
  </developer>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>

  <url type="homepage">https://allodia.eu</url>
  <url type="help">https://allodia.eu/docs/mail-calendar/</url>
  <!-- A real tracker a reader can open, not a support page: `flatpak-builder-lint` fetches every
       URL here and treats a 404 as fatal, and allodia.eu/support does not exist. -->
  <url type="bugtracker">https://github.com/allodia-eu/mail-calendar/issues</url>
  <url type="contact">https://allodia.eu/contact</url>

  <categories>
    <category>Network</category>
    <category>Email</category>
    <category>Office</category>
    <category>Calendar</category>
  </categories>

  <keywords>
    <keyword>email</keyword>
    <keyword>mail</keyword>
    <keyword>calendar</keyword>
    <keyword>IMAP</keyword>
    <keyword>JMAP</keyword>
    <keyword>SMTP</keyword>
    <keyword>CalDAV</keyword>
  </keywords>

@SCREENSHOTS@

  <!-- Mist Blue and the deep navy used for dark surfaces.
       A software centre tints the area behind the icon with these; they are not UI colours. -->
  <branding>
    <color type="primary" scheme_preference="light">#a8cad5</color>
    <color type="primary" scheme_preference="dark">#0b2c46</color>
  </branding>

  <!-- The app itself carries no rated content. What a user's own mail contains is not the app's
       content rating, which is why every mail client publishes an empty OARS block rather than
       rating itself for what someone might be sent. -->
  <content_rating type="oars-1.1"/>

  <!-- Every way the client can be driven, and it needs none of them in particular: a keyboard, a
       mouse or trackpad, and touch, which GTK delivers to the same widgets. `supports` rather than
       `recommends`, which is not a shade of the same claim: a software centre reads a recommended
       input device as one the app is not right without, and files a tablet as incompatible for
       recommending a keyboard. A control left out is read as one the app cannot be used with, so
       `touch` missing here is what put "Touchscreen Not Supported" on the listing. -->
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <!-- Three panes need room. Stated as a recommendation, not a requirement: the window still opens
       narrower, and refusing to install on a small screen would be a worse answer than a cramped
       one.

       `side="longest"` is load-bearing. The attribute defaults to `shortest`, so the same number
       without it claims 960 px of *height*, which files every 1366x768 and 1600x900 laptop as a
       machine this app is not recommended on. It is width the three panes need. -->
  <recommends>
    <display_length side="longest" compare="ge">960</display_length>
  </recommends>

@RELEASES@
</component>
