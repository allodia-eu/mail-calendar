# The identity a build carries when nothing overrides it: the open-source default.
#
# A build of this repository is unbranded unless it is told otherwise, and it is told otherwise by
# `brand.env` beside this file or by the environment (docs/branding.md). Nothing here is secret
# and nothing here is Allodia's; a fork that changes these two lines has rebranded the whole app.

# What the app calls itself wherever a person reads a name: the launcher, the window, the
# installer, the About screen. Deliberately not localized: the product name is one string in all
# seven languages, and a per-locale copy of a constant is a copy that can drift.
MAILCAL_APP_NAME="MailCal"

# The reverse-DNS identifier the operating system knows the app by: the Android applicationId, the
# Apple bundle id, the MSIX package name, the Flatpak app id, and the directory each platform gives
# the app for its data. It is also a URI scheme (JMAP sign-in redirects to `<id>://jmap-oauth`),
# so it must be **all lowercase**: Android compares an intent filter's scheme case-sensitively and
# an uppercase one silently never matches.
MAILCAL_APP_ID="org.mailcal.client"

# The name the Snap Store knows the app by: the package name, its store URL and the command it
# installs. A snap name is reserved in the store rather than derived from anything, and cannot be
# renamed afterwards, so it is stated rather than computed from the app id. Lowercase letters,
# digits and hyphens, at most 40 characters.
MAILCAL_SNAP_NAME="mailcal"

# What the app's bundle and its executable are called on macOS and iOS: the `.app` a person drags
# into Applications and sees in Finder, and the process Activity Monitor lists. Letters and digits
# only, because every script that builds, signs or stops the app names that path.
MAILCAL_APPLE_PRODUCT_NAME="MailCal"

# Where the app keeps its mail store, its diagnostic log and its MCP endpoint on this device: the
# directory under `~/.local/share` on macOS and Linux, and under Application Support on iOS. Every
# derived directory starts with it (`<name>-dev-*` for a debug build, `<name>-share` for the Mac's
# share box). Two brands with the same value on one Mac or one Linux account share one mailbox, so
# a publisher states its own. Lowercase letters, digits and hyphens. Like the app id, it is where
# existing installations keep their mail, so once shipped it does not change.
MAILCAL_DATA_DIR_NAME="mailcal"
# The same on Windows, as a path under %LOCALAPPDATA%, with `/` between its segments. A packaged
# build writes there unvirtualized, so it has the same rule.
MAILCAL_WINDOWS_DATA_DIR="MailCal"

# The MSIX package identity. Windows takes these three from the Store reservation rather than from
# the app id, so they are named separately, but they are stated here too, so that every key has a
# value in every build and no consumer has to carry a fallback. An unbranded build is not the one
# being uploaded, so a self-signed placeholder is the right answer for it.
MAILCAL_MSIX_IDENTITY_NAME="org.mailcal.client"
MAILCAL_MSIX_PUBLISHER="CN=MailCal"
MAILCAL_MSIX_PUBLISHER_DISPLAY_NAME="MailCal"

# The identity a package we host ourselves carries, which is a different package from the Store's.
#
# Windows matches a sideloaded package's manifest Publisher against the subject of the certificate
# that signed it, and the Store's publisher is a GUID Partner Center issued for a certificate only
# Microsoft holds. So the two channels cannot share one identity, and a machine can hold both at
# once (docs/windows-channels.md). An unbranded build ships through neither, so these repeat the
# values above rather than inventing a second placeholder.
MAILCAL_MSIX_DIRECT_IDENTITY_NAME="org.mailcal.client"
MAILCAL_MSIX_DIRECT_PUBLISHER="CN=MailCal"

# Where the app sends a person who wants to know more, each one the publisher's own page. A build
# shows these and never computes them, so a publisher states each one. The neutral values point at
# this repository, which is the only thing an unbranded build can honestly send anyone to.
#
# The privacy policy linked from the welcome screen, one address for every language.
MAILCAL_PRIVACY_URL="https://github.com/allodia-eu/mail-calendar/blob/main/docs/privacy-policy.md"
# Where Settings → About sends someone with a problem.
MAILCAL_SUPPORT_URL="https://github.com/allodia-eu/mail-calendar/issues"

# The key an MCP client files the app's local server under, and the name the server gives itself
# (docs/mcp.md). Letters, digits and hyphens only: Claude Code rewrites anything else. Users write it
# into their own configuration, so once shipped it does not change.
MAILCAL_MCP_SERVER_NAME="mailcal"
# The command the MCP relay is installed as: the nested bundle on macOS, the App Execution Alias on
# Windows, the Flatpak command and the snap app on Linux. It is what the configuration snippet the
# app offers spawns, so it follows the same rule: letters, digits and hyphens, and once shipped it
# does not change. The binary cargo builds is `mailcal-mcp` whatever this says.
MAILCAL_MCP_RELAY_NAME="mailcal-mcp"
# The publisher's home page, where the app's local MCP server says to find out what it is.
MAILCAL_WEBSITE_URL="https://github.com/allodia-eu/mail-calendar"

# Who publishes this build, as the Linux software centre shows it (the AppStream `<developer>`
# block): a reverse-DNS id the publisher controls, and its name.
MAILCAL_PUBLISHER_ID="org.mailcal"
MAILCAL_PUBLISHER_NAME="MailCal"
# The software centre's help and contact links. `flatpak-builder-lint` fetches both and fails a
# 404, so each must be a page that exists.
MAILCAL_HELP_URL="https://github.com/allodia-eu/mail-calendar/tree/main/docs"
MAILCAL_CONTACT_URL="https://github.com/allodia-eu/mail-calendar/issues"
# The colours a software centre tints the area behind the icon with, for a light and a dark scheme.
MAILCAL_PRIMARY_COLOR_LIGHT="#deddda"
MAILCAL_PRIMARY_COLOR_DARK="#3d3846"
